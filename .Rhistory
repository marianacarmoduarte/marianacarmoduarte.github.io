#GRAPHS
#Figure 2
m <-margins(modelg1.1, variables = "Frame",
at=list(Salience = c("1. Low",
"2. High")))
a <- summary(m, level = 0.95)
ggplot(a, aes(x = Salience, y = AME, fill = Salience)) +
geom_point(position = position_dodge(0.6)) +
geom_bar(stat = "identity", position = "dodge", width = 0.6, alpha = 0.5, color = "black") +  # Create bars
geom_errorbar(data = a, aes(ymin = lower, ymax = upper), width = 0.05, position = position_dodge(0.6)) +
geom_ribbon(data = a, aes(ymin = lower, ymax = upper), alpha = 0.2) +
geom_text(
aes(label = scales::comma(AME,accuracy = 0.02), y = AME + 0.4),
position = position_dodge(0.7),
vjust = 0
)+
geom_signif(y_position = c(5.5), xmin = c(0.8),
xmax = c(2.2), annotation = c("***"),
tip_length = c(0.07, 0.07)) +
xlab("") +
ylab("Marginal Effect of Frames on Support towards EU Issues") +
labs(fill = "Salience") +
labs(caption = "Note: *p<0.1; **<0.05; ***p<0.001") +
scale_y_continuous(limits = c(0, 10)) +
labs(title = "") +
theme_minimal() +
theme(axis.text.x = element_blank()) +
scale_fill_grey(start=0.4, end=0.8)+
theme(plot.title = element_text(size = 11)) +
theme(
panel.grid.major.x = element_blank(),  # Remove major vertical grid lines
panel.grid.minor.x = element_blank()   # Remove minor vertical grid lines
)
