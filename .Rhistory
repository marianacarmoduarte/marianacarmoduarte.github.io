summary(modeli1.2)
#Model (3) - Salience - EU Knowledge II
modeli1.3 <- lm(att ~ Frame*Salience*I(pk_eu == 1) + Frame*Salience*I(pk_eu == 3), data = data)
summary(modeli1.3)
#Model (4) - Salience - Political Interest I
