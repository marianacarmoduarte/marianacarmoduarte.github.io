#TABLE H1
#Model (1) - Salience
modelh1.1 <- lm(att ~ Frame*Salience + educ + pol_int + as.factor(pk_eu), data = data)
summary(modelh1.1)
View(data)
#Model (2) - Polarisation
modelh1.2 <- lm(att ~ Frame*Polarisation + educ + pol_int + as.factor(pk_eu), data = data)
summary(modelh1.2)
#Model (3) - Politicisation I
modelh1.3 <- lm(att ~ Frame*I(Politicisation == "2. Low Salience & High Polarization") +
Frame*I(Politicisation == "3. High Salience & Low Polarization") +
Frame*I(Politicisation == "4. High Salience & High Polarization") +
+ educ + pol_int + as.factor(pk_eu),
data = data)
summary(modelh1.3)
#Model (4) - Politicisation II
modelh1.4 <- lm(att ~ Frame*I(Politicisation == "1. Low Salience & Low Polarization") +
Frame*I(Politicisation == "3. High Salience & Low Polarization") +
Frame*I(Politicisation == "4. High Salience & High Polarization") +
+ educ + pol_int + as.factor(pk_eu),
data = data)
summary(modelh1.4)
#Model (5) - Politicisation III
modelh1.5 <- lm(att ~ Frame*I(Politicisation == "1. Low Salience & Low Polarization") +
Frame*I(Politicisation == "2. Low Salience & High Polarization") +
Frame*I(Politicisation == "4. High Salience & High Polarization") +
+ educ + pol_int + as.factor(pk_eu),
data = data)
summary(modelh1.5)
stargazer(modelh1.1, modelh1.2, modelh1.3, modelh1.4, modelh1.5,
title = "",
model.numbers = T,
type = "latex",  font.size = "scriptsize",
dep.var.labels=c("Support towards EU Issues"),
star.char = c("*", "**", "***"),
star.cutoffs = c(0.1, 0.05, 0.001),
notes = c("*p<0.1; **p<0.05; ***p<0.001"),
no.space = T,
notes.append = F)
